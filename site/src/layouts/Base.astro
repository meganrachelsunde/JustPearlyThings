---
import { SITE } from "../config";

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/watch", label: "Watch" },
  { href: "/donate", label: "Donate" },
  { href: "/events", label: "Events" },
  { href: "/blog", label: "Blog" },
  { href: "/resources", label: "Resources" },
  { href: "/statistics", label: "Statistics" },
  { href: "/about", label: "About" },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | JustPearlyThings</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | JustPearlyThings`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="pearl-field" aria-hidden="true">
      <span class="floater f1">P</span>
      <span class="floater f2">P</span>
      <span class="floater f3">P</span>
      <span class="floater f4">P</span>
      <span class="floater f5">P</span>
      <span class="floater f6">P</span>
      <span class="orb o1"></span>
      <span class="orb o2"></span>
      <span class="orb o3"></span>
    </div>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">P</span>
        <span class="brand-name">JustPearlyThings</span>
      </a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} class:list={[{ active: current === item.href || (item.href !== "/" && current.startsWith(item.href)) }]}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <p class="footer-brand">JustPearlyThings</p>
        </div>
        <div class="footer-links">
          <a href="/links">All links</a>
          <a href="/donate">Donate</a>
          <a href="/transparency">Transparency</a>
          <a href="/legal">Legal &amp; disclaimers</a>
          <a href="https://theaudacitynetwork.com" rel="noopener">The Audacity Network</a>
          <a href="https://justpearlymerch.com" rel="noopener">Merch</a>
        </div>
      </div>
      <p class="muted small center">
        Commentary and opinion, loudly held. Not legal, tax, or medical advice —
        <a href="/legal">the fine print explains itself</a>.
      </p>
      <p class="muted small center">
        © {new Date().getFullYear()} JustPearlyThings, LLC ·
        <a href="/about">Contact</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Cream and gold on warm ink: ivory text, champagne-gold accents,
       near-black base with a warm cast. */
    --bg: #0f0d09;
    --bg-raised: #181510;
    --bg-card: #1d1913;
    --border: #332c1f;
    --text: #f8f3e6;
    --text-muted: #b5aa93;
    --accent: #d9b877;
    --accent-strong: #ecd39a;
    --accent-ink: #241a08;
    --accent-glow: rgba(217, 184, 119, 0.1);
    /* Secondary hue: soft violet, used in glows and gradient tails. */
    --violet: #a678d6;
    --violet-glow: rgba(146, 96, 194, 0.12);
    --pearl-sheen: linear-gradient(135deg, #f8eed6 0%, #e6cb90 55%, #c9a55c 100%);
    --radius: 14px;
    --max: 1080px;
    --font-display: "Montserrat", "Avenir Next", "Segoe UI", system-ui, sans-serif;
    --font-body: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    /* Candlelit gold at the top right, a soft violet bloom at the left,
       so the page has depth instead of flat gray. */
    background:
      radial-gradient(1100px 480px at 72% -12%, var(--accent-glow), transparent 65%),
      radial-gradient(950px 520px at 8% 4%, var(--violet-glow), transparent 62%),
      radial-gradient(800px 600px at 92% 78%, rgba(146, 96, 194, 0.07), transparent 60%),
      var(--bg);
    background-attachment: fixed;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0 0 0.5rem; font-weight: 900; }
  h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 2.5rem 0 0.75rem; font-weight: 800; }
  h3 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; font-weight: 700; }

  a { color: var(--accent-strong); text-decoration: none; }
  a:hover { color: #f8ead1; text-decoration: underline; }

  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  .muted { color: var(--text-muted); }
  .small { font-size: 0.85rem; }
  .center { text-align: center; }

  .lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 46rem;
    margin: 0 0 1.5rem;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(15, 13, 9, 0.9);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
  }
  .brand:hover { text-decoration: none; color: var(--text); }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    /* Gold pearl orb: cream highlight off-center, deep gold at the rim. */
    background: radial-gradient(circle at 32% 28%, #fdf6e3 0%, #e6cb90 45%, #a8813c 100%);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 900;
    box-shadow: 0 0 14px rgba(217, 184, 119, 0.35);
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .site-header nav a {
    color: #ded6c5;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }
  .site-header nav a:hover {
    color: var(--text);
    text-decoration: none;
    background: var(--bg-raised);
    border-color: var(--border);
  }
  .site-header nav a.active {
    color: var(--accent-strong);
    background: rgba(217, 184, 119, 0.1);
    border-color: rgba(217, 184, 119, 0.4);
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--bg-card);
    transition: transform 120ms ease, background 120ms ease;
  }
  .btn:hover { text-decoration: none; transform: translateY(-1px); background: var(--bg-raised); color: var(--text); }

  .btn.primary {
    position: relative;
    overflow: hidden;
    background: var(--pearl-sheen);
    border-color: transparent;
    color: var(--accent-ink);
    box-shadow: 0 4px 18px rgba(217, 184, 119, 0.22);
  }
  .btn.primary:hover { color: var(--accent-ink); filter: brightness(1.05); }
  /* Light sweep across gold buttons on hover. */
  .btn.primary::after {
    content: "";
    position: absolute;
    top: 0;
    left: -80%;
    width: 55%;
    height: 100%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-18deg);
    transition: left 450ms ease;
    pointer-events: none;
  }
  .btn.primary:hover::after { left: 130%; }

  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0;
  }

  .card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)) , var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    transition: border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
  }
  .card:hover {
    border-color: rgba(217, 184, 119, 0.45);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  }
  a.card:hover { transform: translateY(-2px); }

  .grid {
    display: grid;
    gap: 1rem;
  }
  .grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .pill {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-strong);
    background: rgba(217, 184, 119, 0.1);
    border: 1px solid rgba(217, 184, 119, 0.35);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .notice {
    border-left: 3px solid var(--accent);
    background: var(--bg-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 0.9rem 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem 1.25rem 2.5rem;
  }

  .footer-inner {
    max-width: var(--max);
    margin: 0 auto 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-brand { font-weight: 700; margin: 0 0 0.25rem; }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th, td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  th { color: var(--text-muted); font-weight: 600; }

  code {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.1rem 0.4rem;
    font-size: 0.9em;
    word-break: break-all;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1rem;
    color: var(--text-muted);
  }

  /* ---- Floating pearl stamps -------------------------------------- */
  .pearl-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .pearl-field .floater {
    position: absolute;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 900;
    color: rgba(36, 26, 8, 0.75);
    background: radial-gradient(circle at 32% 28%, #fdf6e3 0%, #e6cb90 45%, #a8813c 100%);
    box-shadow: 0 0 22px rgba(217, 184, 119, 0.28);
    opacity: 0.16;
    animation: drift 22s ease-in-out infinite alternate;
  }

  /* Soft out-of-focus orbs, two of them violet. */
  .pearl-field .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(26px);
    opacity: 0.2;
    animation: drift 26s ease-in-out infinite alternate;
  }

  .floater.f1 { width: 54px; height: 54px; font-size: 26px; top: 14%; left: 5%;  animation-duration: 24s; }
  .floater.f2 { width: 34px; height: 34px; font-size: 16px; top: 32%; left: 88%; animation-duration: 19s; animation-delay: -6s; }
  .floater.f3 { width: 26px; height: 26px; font-size: 12px; top: 66%; left: 10%; animation-duration: 27s; animation-delay: -12s; }
  .floater.f4 { width: 44px; height: 44px; font-size: 21px; top: 78%; left: 80%; animation-duration: 21s; animation-delay: -3s; }
  .floater.f5 { width: 20px; height: 20px; font-size: 10px; top: 8%;  left: 62%; animation-duration: 17s; animation-delay: -9s; }
  .floater.f6 { width: 30px; height: 30px; font-size: 14px; top: 50%; left: 46%; animation-duration: 29s; animation-delay: -15s; opacity: 0.1; }

  .orb.o1 { width: 190px; height: 190px; top: 20%; left: 76%; background: var(--violet); animation-duration: 30s; }
  .orb.o2 { width: 150px; height: 150px; top: 72%; left: 2%;  background: var(--accent); animation-duration: 24s; animation-delay: -8s; }
  .orb.o3 { width: 120px; height: 120px; top: 44%; left: 30%; background: var(--violet); animation-duration: 34s; animation-delay: -16s; opacity: 0.14; }

  @keyframes drift {
    0%   { transform: translate(0, 0) rotate(0deg); }
    25%  { transform: translate(22px, -30px) rotate(4deg); }
    50%  { transform: translate(-16px, -54px) rotate(-3deg); }
    75%  { transform: translate(28px, -22px) rotate(5deg); }
    100% { transform: translate(-12px, 12px) rotate(-4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pearl-field .floater,
    .pearl-field .orb { animation: none; }
    .btn.primary::after { display: none; }
  }
</style>
