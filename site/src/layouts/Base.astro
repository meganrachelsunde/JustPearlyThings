---
import { SITE } from "../config";

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/watch", label: "Watch" },
  { href: "/donate", label: "Donate" },
  { href: "/events", label: "Events" },
  { href: "/blog", label: "Blog" },
  { href: "/resources", label: "Resources" },
  { href: "/statistics", label: "Statistics" },
  { href: "/about", label: "About" },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | JustPearlyThings</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | JustPearlyThings`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">P</span>
        <span class="brand-name">JustPearlyThings</span>
      </a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} class:list={[{ active: current === item.href || (item.href !== "/" && current.startsWith(item.href)) }]}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <p class="footer-brand">JustPearlyThings</p>
          <p class="muted">{SITE.tagline}</p>
        </div>
        <div class="footer-links">
          <a href="/links">All links</a>
          <a href="/donate">Donate</a>
          <a href="https://theaudacitynetwork.com" rel="noopener">The Audacity Network</a>
          <a href="https://justpearlymerch.com" rel="noopener">Merch</a>
        </div>
      </div>
      <p class="muted small center">
        © {new Date().getFullYear()} JustPearlyThings, LLC ·
        <a href="/about">Contact</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d0c0f;
    --bg-raised: #17151b;
    --bg-card: #1d1a22;
    --border: #2c2833;
    --text: #f2eef7;
    --text-muted: #a79fb3;
    --accent: #e8b64c;
    --accent-strong: #f4c964;
    --accent-ink: #201703;
    --radius: 14px;
    --max: 1080px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Avenir Next", Avenir, "Segoe UI", system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0 0 0.5rem; }
  h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 2.5rem 0 0.75rem; }
  h3 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; }

  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-strong); text-decoration: underline; }

  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  .muted { color: var(--text-muted); }
  .small { font-size: 0.85rem; }
  .center { text-align: center; }

  .lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 46rem;
    margin: 0 0 1.5rem;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(13, 12, 15, 0.92);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
  }
  .brand:hover { text-decoration: none; color: var(--text); }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--accent-strong), #b8862a);
    color: var(--accent-ink);
    font-weight: 800;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .site-header nav a {
    color: var(--text-muted);
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: 0.95rem;
  }
  .site-header nav a:hover { color: var(--text); text-decoration: none; background: var(--bg-raised); }
  .site-header nav a.active { color: var(--accent); background: var(--bg-raised); }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--bg-card);
    transition: transform 120ms ease, background 120ms ease;
  }
  .btn:hover { text-decoration: none; transform: translateY(-1px); background: var(--bg-raised); color: var(--text); }

  .btn.primary {
    background: linear-gradient(135deg, var(--accent-strong), #cf9a30);
    border-color: transparent;
    color: var(--accent-ink);
  }
  .btn.primary:hover { color: var(--accent-ink); filter: brightness(1.05); }

  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }
  .grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: rgba(232, 182, 76, 0.12);
    border: 1px solid rgba(232, 182, 76, 0.35);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .notice {
    border-left: 3px solid var(--accent);
    background: var(--bg-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 0.9rem 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem 1.25rem 2.5rem;
  }

  .footer-inner {
    max-width: var(--max);
    margin: 0 auto 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-brand { font-weight: 700; margin: 0 0 0.25rem; }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th, td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  th { color: var(--text-muted); font-weight: 600; }

  code {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.1rem 0.4rem;
    font-size: 0.9em;
    word-break: break-all;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1rem;
    color: var(--text-muted);
  }
</style>
