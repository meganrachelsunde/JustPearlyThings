---
import Base from "../layouts/Base.astro";
import { sourceQualityLabels, statisticsRecords } from "../data/statistics";

const categories = [...new Set(statisticsRecords.map((s) => s.category))].sort();
const total = statisticsRecords.length;
const publishedCount = statisticsRecords.filter((s) => s.status === "published").length;
const videoCount = statisticsRecords.filter((s) => s.status === "from_video").length;
const needsSourceCount = statisticsRecords.filter((s) => s.status === "needs_source").length;
---

<Base title="Statistics & Sources" description="The numbers behind the show — every claim with a link to its primary source.">
  <span class="pill">Receipts included</span>
  <h1>Statistics &amp; sources</h1>
  <p class="lede">
    Every claim published here has a link to its primary source. Every claim that
    doesn't is flagged — you can read either, but you can't confuse them.
  </p>

  <div class="grid cols-3 stats-overview">
    <div class="card">
      <p class="muted small">Total records</p>
      <h2 class="kpi">{total}</h2>
    </div>
    <div class="card">
      <p class="muted small">Published claims</p>
      <h2 class="kpi">{publishedCount}</h2>
    </div>
    <div class="card">
      <p class="muted small">Research queue</p>
      <h2 class="kpi">{videoCount + needsSourceCount}</h2>
    </div>
  </div>

  <section class="card filters">
    <h2 style="margin-top:0;">Filter the dataset</h2>
    <div class="filter-grid">
      <label>
        Search
        <input id="filter-search" type="search" placeholder="custody, labor, TikTok bans..." />
      </label>
      <label>
        Category
        <select id="filter-category">
          <option value="">All categories</option>
          {categories.map((cat) => <option value={cat}>{cat}</option>)}
        </select>
      </label>
      <label>
        Status
        <select id="filter-status">
          <option value="">All statuses</option>
          <option value="published">Published</option>
          <option value="from_video">From video transcript</option>
          <option value="needs_source">Needs source</option>
        </select>
      </label>
      <label>
        Lens
        <select id="filter-lens">
          <option value="">All lenses</option>
          <option value="feminist-statistics">Feminist statistics</option>
          <option value="family-court">Family court</option>
          <option value="deplatforming">Deplatforming</option>
          <option value="labor">Labor/economy</option>
          <option value="public-health">Public health</option>
        </select>
      </label>
    </div>
  </section>

  <section>
    <h2>Feminist statistics</h2>
    <p class="muted">
      The specific claims cited most often in public feminist discourse — pay gap,
      domestic violence, custody, mental health, participation and attainment. Each entry
      here will link the actual primary source and the methodology the argument turns on,
      so the claim can be evaluated on the data instead of on the slogan. Entries move
      from <code>needs source</code> to <code>published</code> as the sourcing is
      completed.
    </p>
    <div class="grid cols-2">
      {statisticsRecords
        .filter((r) => r.lens.includes("feminist-statistics"))
        .map((r) => (
          <article class="card stat-card"
            data-category={r.category}
            data-status={r.status}
            data-lens={r.lens.join(" ")}
            data-search={`${r.title} ${r.claim} ${r.sourceTitle} ${r.notes ?? ""}`.toLowerCase()}>
            <div class="row">
              <h3>{r.title}</h3>
              <span class:list={["status", r.status]}>
                {r.status.replaceAll("_", " ")}
              </span>
            </div>
            <p>{r.claim}</p>
            <p class="muted small">Category: {r.category}</p>
            <p class="muted small">Source quality: {sourceQualityLabels[r.sourceQuality]}</p>
            <p class="muted small">
              Source: <a href={r.sourceUrl} rel="noopener">{r.sourceTitle}</a>
            </p>
            {r.notes && <p class="muted small">{r.notes}</p>}
          </article>
        ))}
    </div>
  </section>

  <section>
    <h2>All records</h2>
    <div id="stats-grid" class="grid cols-2">
      {statisticsRecords.map((r) => (
        <article class="card stat-card"
          data-category={r.category}
          data-status={r.status}
          data-lens={r.lens.join(" ")}
          data-search={`${r.title} ${r.claim} ${r.sourceTitle} ${r.notes ?? ""}`.toLowerCase()}>
          <div class="row">
            <h3>{r.title}</h3>
            <span class:list={["status", r.status]}>
              {r.status.replaceAll("_", " ")}
            </span>
          </div>
          {r.valueText && <p class="value">{r.valueText}</p>}
          <p>{r.claim}</p>
          <p class="muted small">Category: {r.category}</p>
          <p class="muted small">Lens: {r.lens.join(", ")}</p>
          <p class="muted small">Source quality: {sourceQualityLabels[r.sourceQuality]}</p>
          <p class="muted small">
            Source: <a href={r.sourceUrl} rel="noopener">{r.sourceTitle}</a>
          </p>
          {r.notes && <p class="muted small">{r.notes}</p>}
        </article>
      ))}
    </div>
    <p id="no-results" class="notice hidden" style="margin-top: 1rem;">
      No records matched those filters.
    </p>
  </section>

  <p class="notice" style="margin-top: 2rem;">
    <strong>Source policy.</strong> <code>Published</code> records cite a primary
    dataset — government tables, court administrative data, or peer-reviewed research.
    <code>From video</code> records are things Pearl has said on air that still need
    independent sourcing before being treated as verified. <code>Needs source</code>
    records are research prompts on the queue. This page is intended to be checkable line
    by line.
  </p>
</Base>

<script>
  const searchInput = document.getElementById("filter-search");
  const categorySelect = document.getElementById("filter-category");
  const statusSelect = document.getElementById("filter-status");
  const lensSelect = document.getElementById("filter-lens");
  const cards = Array.from(document.querySelectorAll("#stats-grid .stat-card"));
  const noResults = document.getElementById("no-results");

  function applyFilters() {
    const search = (searchInput?.value || "").trim().toLowerCase();
    const category = categorySelect?.value || "";
    const status = statusSelect?.value || "";
    const lens = lensSelect?.value || "";

    let visible = 0;
    cards.forEach((card) => {
      const text = card.getAttribute("data-search") || "";
      const cardCategory = card.getAttribute("data-category") || "";
      const cardStatus = card.getAttribute("data-status") || "";
      const cardLens = card.getAttribute("data-lens") || "";
      const matchesSearch = !search || text.includes(search);
      const matchesCategory = !category || cardCategory === category;
      const matchesStatus = !status || cardStatus === status;
      const matchesLens = !lens || cardLens.includes(lens);
      const show = matchesSearch && matchesCategory && matchesStatus && matchesLens;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    });

    noResults?.classList.toggle("hidden", visible > 0);
  }

  [searchInput, categorySelect, statusSelect, lensSelect].forEach((el) => {
    el?.addEventListener("input", applyFilters);
    el?.addEventListener("change", applyFilters);
  });
</script>

<style>
  .kpi { margin: 0; }
  .stats-overview h2 { margin-top: 0.15rem; }
  .filters { margin-top: 1rem; }
  .filter-grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  label {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.35rem;
  }
  input, select {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 10px;
    padding: 0.55rem 0.65rem;
  }
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .row h3 { margin-top: 0; }
  .value {
    margin: 0.2rem 0 0.6rem;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .status {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .status.published {
    color: #76d3a9;
    background: rgba(118, 211, 169, 0.12);
    border-color: rgba(118, 211, 169, 0.5);
  }
  .status.from_video {
    color: #f5c978;
    background: rgba(245, 201, 120, 0.12);
    border-color: rgba(245, 201, 120, 0.5);
  }
  .status.needs_source {
    color: #d4a7ff;
    background: rgba(212, 167, 255, 0.12);
    border-color: rgba(212, 167, 255, 0.5);
  }
  .hidden { display: none !important; }
</style>
