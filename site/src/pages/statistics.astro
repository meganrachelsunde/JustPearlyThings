---
import Base from "../layouts/Base.astro";
import { publishedStatisticsRecords, sourceQualityLabels } from "../data/statistics";

const categories = [...new Set(publishedStatisticsRecords.map((s) => s.category))].sort();
const publishedCount = publishedStatisticsRecords.length;
const sourceCount = new Set(publishedStatisticsRecords.map((s) => s.sourceUrl)).size;
---

<Base title="Statistics & Sources" description="The numbers behind the show — every claim with a link to its primary source.">
  <span class="pill">Receipts included</span>
  <h1>Statistics &amp; sources</h1>
  <p class="lede">
    Every claim on this page links to a primary source and identifies the year,
    table, population, and limitation. Unverified show claims stay off the public page.
  </p>

  <div class="grid cols-3 stats-overview">
    <div class="card">
      <p class="muted small">Published claims</p>
      <h2 class="kpi">{publishedCount}</h2>
    </div>
    <div class="card">
      <p class="muted small">Primary sources</p>
      <h2 class="kpi">{sourceCount}</h2>
    </div>
    <div class="card">
      <p class="muted small">Citation standard</p>
      <h2 class="kpi words">Year · table · method</h2>
    </div>
  </div>

  <section class="card filters">
    <h2 style="margin-top:0;">Filter the dataset</h2>
    <div class="filter-grid">
      <label>
        Search
        <input id="filter-search" type="search" placeholder="custody, earnings, suicide..." />
      </label>
      <label>
        Category
        <select id="filter-category">
          <option value="">All categories</option>
          {categories.map((cat) => <option value={cat}>{cat}</option>)}
        </select>
      </label>
      <label>
        Lens
        <select id="filter-lens">
          <option value="">All lenses</option>
          <option value="feminist-statistics">Feminist statistics</option>
          <option value="family-court">Family court</option>
          <option value="deplatforming">Deplatforming</option>
          <option value="labor">Labor/economy</option>
          <option value="public-health">Public health</option>
        </select>
      </label>
    </div>
  </section>

  <section>
    <h2>Published evidence</h2>
    <p class="muted">
      The cards distinguish what a dataset measures from what it cannot establish.
      A descriptive difference is not automatically evidence of its cause.
    </p>
    <div id="stats-grid" class="grid cols-2">
      {publishedStatisticsRecords.map((r) => (
        <article class="card stat-card"
          data-category={r.category}
          data-status={r.status}
          data-lens={r.lens.join(" ")}
          data-search={`${r.title} ${r.claim} ${r.sourceTitle} ${r.notes ?? ""}`.toLowerCase()}>
          <div class="row">
            <h3>{r.title}</h3>
            <span class:list={["status", r.status]}>
              {r.status.replaceAll("_", " ")}
            </span>
          </div>
          {r.valueText && <p class="value">{r.valueText}</p>}
          <p>{r.claim}</p>
          <p class="muted small">Category: {r.category}</p>
          <p class="muted small">Lens: {r.lens.join(", ")}</p>
          <p class="muted small">Source quality: {sourceQualityLabels[r.sourceQuality]}</p>
          <p class="muted small">
            Source: <a href={r.sourceUrl} rel="noopener">{r.sourceTitle}</a>
          </p>
          {r.tableReference && (
            <p class="citation"><strong>Exact citation:</strong> {r.tableReference}</p>
          )}
          {r.methodology && (
            <p class="method"><strong>What was measured:</strong> {r.methodology}</p>
          )}
          {r.notes && (
            <p class="limitation"><strong>What this does not prove:</strong> {r.notes}</p>
          )}
        </article>
      ))}
    </div>
    <p id="no-results" class="notice hidden" style="margin-top: 1rem;">
      No records matched those filters.
    </p>
  </section>

  <p class="notice" style="margin-top: 2rem;">
    <strong>Source policy.</strong> Public records must cite a primary government
    dataset or peer-reviewed study, name the exact table or figure, define the measured
    population, and state the material limitation. Transcript claims and research prompts
    remain in the private editorial queue until they meet that standard.
  </p>
</Base>

<script>
  const searchInput = document.getElementById("filter-search");
  const categorySelect = document.getElementById("filter-category");
  const lensSelect = document.getElementById("filter-lens");
  const cards = Array.from(document.querySelectorAll("#stats-grid .stat-card"));
  const noResults = document.getElementById("no-results");

  function applyFilters() {
    const search = (searchInput?.value || "").trim().toLowerCase();
    const category = categorySelect?.value || "";
    const lens = lensSelect?.value || "";

    let visible = 0;
    cards.forEach((card) => {
      const text = card.getAttribute("data-search") || "";
      const cardCategory = card.getAttribute("data-category") || "";
      const cardLens = card.getAttribute("data-lens") || "";
      const matchesSearch = !search || text.includes(search);
      const matchesCategory = !category || cardCategory === category;
      const matchesLens = !lens || cardLens.includes(lens);
      const show = matchesSearch && matchesCategory && matchesLens;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    });

    noResults?.classList.toggle("hidden", visible > 0);
  }

  [searchInput, categorySelect, lensSelect].forEach((el) => {
    el?.addEventListener("input", applyFilters);
    el?.addEventListener("change", applyFilters);
  });
</script>

<style>
  .kpi { margin: 0; }
  .kpi.words { font-size: 1.15rem; }
  .stats-overview h2 { margin-top: 0.15rem; }
  .filters { margin-top: 1rem; }
  .filter-grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  label {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.35rem;
  }
  input, select {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 10px;
    padding: 0.55rem 0.65rem;
  }
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .row h3 { margin-top: 0; }
  .value {
    margin: 0.2rem 0 0.6rem;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .citation, .method, .limitation {
    margin: 0.75rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .citation { color: var(--text-muted); }
  .method { color: var(--text); }
  .limitation {
    color: #d8d6da;
    background: rgba(232, 53, 46, 0.06);
    border: 1px solid rgba(232, 53, 46, 0.25);
    border-radius: 10px;
    padding: 0.75rem;
  }
  .status {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .status.published {
    color: #76d3a9;
    background: rgba(118, 211, 169, 0.12);
    border-color: rgba(118, 211, 169, 0.5);
  }
  .status.from_video {
    color: #f5c978;
    background: rgba(245, 201, 120, 0.12);
    border-color: rgba(245, 201, 120, 0.5);
  }
  .status.needs_source {
    color: #d4a7ff;
    background: rgba(212, 167, 255, 0.12);
    border-color: rgba(212, 167, 255, 0.5);
  }
  .hidden { display: none !important; }
</style>
