---
import Base from "../layouts/Base.astro";
import EmailSignup from "../components/EmailSignup.astro";
import { SITE, CTA } from "../config";
import { getLatestEpisodes } from "../lib/episodes";

const { episodes, live } = await getLatestEpisodes(6);
const hasVideo = SITE.missionVideoEmbedUrl.length > 0;
---

<Base title="Home" description={SITE.tagline}>
  <section class="hero">
    <span class="pill">Independent media</span>
    <h1>Truth doesn't become false because it's unpopular.</h1>
    <p class="lede">It becomes harder to find. That's why this network exists.</p>
    <p class="muted">
      Documentaries, a daily show, and reporting on dating, family, and the family
      courts — funded by the people who want the work made, not by whoever gets to
      decide what runs. The full library lives at
      <a href={CTA.membership.url} rel="noopener">The Audacity Network</a>;
      the sources, the mission, and the ways to support it live here.
    </p>

    <div class="video-frame">
      {hasVideo ? (
        <iframe
          src={SITE.missionVideoEmbedUrl}
          title="Our mission"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <div class="video-placeholder">
          <p>
            <strong>Mission video goes here.</strong><br />
            Add the embed URL in <code>src/config.ts</code> once Pearl records it.
          </p>
        </div>
      )}
    </div>

    <div class="btn-row">
      <a class="btn primary" href={CTA.donate.url}>{CTA.donate.label}</a>
      <a class="btn" href={CTA.membership.url} rel="noopener">{CTA.membership.label}</a>
      <a class="btn" href="#email">Get updates</a>
    </div>
  </section>

  <section>
    <h2>Where the money goes</h2>
    <div class="grid cols-3">
      <div class="card">
        <h3>Content</h3>
        <p class="muted">
          Reporting is labor. Editors, producers, and writers get paid whether or
          not any single piece performs. Viewer funding is what lets a documentary
          get made when it wouldn't earn back its cost on advertising.
        </p>
      </div>
      <div class="card">
        <h3>Legal</h3>
        <p class="muted">
          Covering institutions critically invites lawsuits, meritorious or not.
          Defending them costs money regardless. Budgeting for it up front keeps
          reporting on the record instead of quietly retracted.
        </p>
      </div>
      <div class="card">
        <h3>Fieldwork</h3>
        <p class="muted">
          The stories that matter rarely come to a studio. Interviews with parents
          inside a family-court process, or communities inside a system that failed
          them, take travel and time on the ground.
        </p>
      </div>
    </div>
    <p><a href="/donate">Full breakdown and ways to give →</a></p>
  </section>

  <section>
    <h2>Latest episodes</h2>
    {!live && (
      <p class="notice">
        Live feed unavailable at build time — showing the main channels instead.
      </p>
    )}
    <div class="grid cols-2">
      {episodes.map((ep) => (
        <a class="card episode" href={ep.url} rel="noopener">
          {ep.thumbnail && <img src={ep.thumbnail} alt="" loading="lazy" />}
          <div>
            <strong>{ep.title}</strong>
            {ep.published && (
              <p class="muted small">
                {new Date(ep.published).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
    <p><a href="/watch">All the places to watch →</a></p>
  </section>

  <EmailSignup />
</Base>

<style>
  .hero { margin-bottom: 3rem; }
  .episode {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    color: var(--text);
  }
  .episode:hover { text-decoration: none; border-color: var(--accent); }
  .episode img {
    width: 128px;
    border-radius: 8px;
    flex-shrink: 0;
  }
</style>
