---
import Base from "../layouts/Base.astro";
import EmailSignup from "../components/EmailSignup.astro";
import { SITE, CTA } from "../config";
import { getLatestEpisodes } from "../lib/episodes";

const { episodes, live } = await getLatestEpisodes(6);
const hasVideo = SITE.missionVideoEmbedUrl.length > 0;
---

<Base title="Home" description={SITE.tagline}>
  <section class="hero">
    <span class="pill">The show</span>
    <h1>That's what she said.</h1>
    <p class="lede">
      Fathers, lawyers, judges, feminists. Sources on screen. Follow-up questions
      actually asked. Truth does not negotiate with comfort. Claims go on the record,
      meet the evidence, and either survive scrutiny or they don't.
    </p>

    <div class="btn-row">
      <a class="btn primary" href="#latest">See the latest</a>
      <a class="btn" href={CTA.membership.url} rel="noopener">Full library on Audacity</a>
      <a class="btn" href={CTA.donate.url}>{CTA.donate.label}</a>
    </div>
  </section>

  <section id="latest">
    <h2>Latest episodes</h2>
    {!live && (
      <p class="notice">
        Live feed unavailable at build time — showing the main channels instead.
      </p>
    )}
    <div class="grid cols-2">
      {episodes.map((ep) => (
        <a class="card episode" href={ep.url} rel="noopener">
          {ep.thumbnail && <img src={ep.thumbnail} alt="" loading="lazy" />}
          <div>
            <strong>{ep.title}</strong>
            {ep.published && (
              <p class="muted small">
                {new Date(ep.published).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
    <p><a href="/watch">All the places to watch →</a></p>
  </section>

  <section class="join-strip">
    <div class="join-copy">
      <span class="pill">The full library</span>
      <h2>Join The Audacity Network.</h2>
      <p>
        Every episode, live streams, exclusive documentaries, and the community
        around them. This site is the public front door; the show itself lives on
        Audacity.
      </p>
      <div class="btn-row">
        <a class="btn primary" href={CTA.membership.url} rel="noopener">{CTA.membership.label}</a>
        <a class="btn" href="/about">What this network is</a>
      </div>
    </div>
    <div class="video-frame">
      {hasVideo ? (
        <iframe
          src={SITE.missionVideoEmbedUrl}
          title="Why this network exists"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <div class="video-placeholder">
          <p>
            <strong>Mission video slot.</strong><br />
            Add the YouTube embed URL in <code>src/config.ts</code> once Pearl records the
            one-take on why this network exists.
          </p>
        </div>
      )}
    </div>
  </section>

  <section>
    <h2>Where the money goes</h2>
    <div class="grid cols-3">
      <div class="card">
        <h3>Content</h3>
        <p class="muted">
          Editors, producers, and writers get paid whether or not any single piece
          performs. Viewer funding is what lets a documentary get made when it
          wouldn't earn back its cost on ads alone.
        </p>
      </div>
      <div class="card">
        <h3>Legal</h3>
        <p class="muted">
          Covering institutions honestly invites lawsuits — meritorious or not.
          Budgeting for defense keeps the reporting on the record instead of
          quietly retracted.
        </p>
      </div>
      <div class="card">
        <h3>Fieldwork</h3>
        <p class="muted">
          Travel and time on the ground. Interviews with parents inside a
          family-court process, or communities inside a system that failed them,
          don't come to a studio.
        </p>
      </div>
    </div>
    <p><a href="/donate">Full breakdown and ways to give →</a> · <a href="/transparency">Transparency policy →</a></p>
  </section>

  <EmailSignup />
</Base>

<style>
  .hero {
    margin: 1.5rem 0 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  /* Short iridescent keyline under the hero, like a lower-third on a broadcast. */
  .hero::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 120px;
    height: 3px;
    background: linear-gradient(90deg, #e6cb90 0%, #d9b877 55%, var(--violet, #a678d6) 100%);
    border-radius: 2px;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .hero .lede { max-width: 40rem; }
  .join-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: 2rem;
    background: var(--surface, rgba(255,255,255,0.02));
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    border-radius: 12px;
    margin: 3rem 0;
  }
  .join-copy .pill { margin-bottom: 0.75rem; }
  .join-copy h2 { margin-top: 0.25rem; }
  .join-strip .video-frame { margin: 0; }
  @media (max-width: 720px) {
    .join-strip { grid-template-columns: 1fr; padding: 1.5rem; }
  }
  .episode {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    color: var(--text);
  }
  .episode:hover { text-decoration: none; border-color: var(--accent); }
  .episode img {
    width: 128px;
    border-radius: 8px;
    flex-shrink: 0;
  }
</style>
