---
import Base from "../layouts/Base.astro";
import EmailSignup from "../components/EmailSignup.astro";
import { upcoming, past, AUDIENCE_SURVEY_URL } from "../data/events";
---

<Base title="Events" description="Monthly fundraisers and live shows — with a public record of what each one raised and where the money went.">
  <span class="pill">Live and in person</span>
  <h1>Events</h1>
  <p class="lede">
    Pearl is planning recurring live events and fundraisers. Confirmed dates and stream
    links will be posted here—not guessed in advance.
  </p>

  <div class="card rsvp">
    <h3 style="margin-top:0;">Help choose where Pearl goes next</h3>
    <p class="muted">
      Pearl's audience survey asks where you live and what you want to see. It is not an
      event ticket or a confirmed RSVP.
    </p>
    <a class="btn primary" href={AUDIENCE_SURVEY_URL} rel="noopener" target="_blank">Take the audience survey</a>
  </div>

  <h2>Upcoming</h2>
  {upcoming.length > 0 ? (
    <div class="grid cols-2">
      {upcoming.map((ev) => (
        <div class="card">
          <div class="row">
            <h3 style="margin:0;">{ev.title}</h3>
            {ev.isExample && <span class="badge">Example</span>}
          </div>
          <p class="muted small">
            <span class="format">{ev.format}</span> · {ev.date}
            {ev.time && <> · {ev.time}</>}
          </p>
          <p>{ev.description}</p>
          <div class="btn-row" style="margin-bottom:0;">
            {ev.rsvpUrl && (
              <a class="btn" href={ev.rsvpUrl} rel="noopener" target="_blank">RSVP</a>
            )}
            {ev.streamUrl && (
              <a class="btn primary" href={ev.streamUrl} rel="noopener">Watch live</a>
            )}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="card">
      <h3 style="margin-top:0;">Next event coming soon</h3>
      <p class="muted">
        No date has been announced. When Pearl confirms the city, format, and time,
        this page will carry the official RSVP or stream link.
      </p>
    </div>
  )}

  {past.length > 0 && (
    <>
      <h2>Past events</h2>
      <p class="muted">
        Every past event lists what came in and what the money paid for. This is the
        record.
      </p>
      <div class="grid cols-2">
        {past.map((ev) => (
          <div class="card">
            <div class="row">
              <h3 style="margin:0;">{ev.title}</h3>
              {ev.isExample && <span class="badge">Example</span>}
            </div>
            <p class="muted small">{ev.date}</p>
            <p>{ev.description}</p>
            {(ev.raised || ev.usedFor) && (
              <div class="ledger">
                {ev.raised && (
                  <p class="ledger-line"><strong>Raised:</strong> {ev.raised}</p>
                )}
                {ev.usedFor && (
                  <p class="ledger-line"><strong>Went to:</strong> {ev.usedFor}</p>
                )}
              </div>
            )}
            {ev.recordingUrl && (
              <a class="btn" href={ev.recordingUrl} rel="noopener">Watch the recording</a>
            )}
          </div>
        ))}
      </div>
    </>
  )}

  <EmailSignup />
</Base>

<style>
  .rsvp { border-color: var(--accent); margin-bottom: 2rem; }
  .row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .format { text-transform: capitalize; }
  .small { font-size: 0.9rem; }
  .ledger {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line, rgba(255,255,255,0.1));
  }
  .ledger-line { margin: 0.25rem 0; }
</style>
